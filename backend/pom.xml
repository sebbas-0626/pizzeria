<?xml version="1.0" encoding="UTF-8"?>
<!--
  Backend Pizzería · US-001

  Stack y versiones: docs/adr/0010-versiones-de-java-y-spring-boot.md
  Reglas del repositorio: AGENTS.md
  Convenciones: docs/development/conventions.md y spring-conventions.md

  Principio de versionado: todo lo que gestione el BOM de Spring Boot se declara SIN versión
  (PostgreSQL, Flyway, Testcontainers, Mockito, JUnit, Jackson, Hibernate).
  Sólo se fija versión de lo que Spring Boot no gestiona, y con el motivo escrito al lado.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <!-- Versión fijada en ADR-0010. No se sube a la ligera: cambiar el framework
             exige revisar springdoc, Testcontainers y el resto del stack. -->
        <version>4.1.2</version>
        <relativePath/>
    </parent>

    <groupId>com.pizzeria</groupId>
    <artifactId>pizzeria-backend</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <name>pizzeria-backend</name>
    <description>Backend de una pizzería: catálogo, pedidos para recogida presencial y pago en efectivo</description>

    <properties>
        <!-- ==================== Java ==================== -->
        <!-- ADR-0010: Java 21 LTS es el objetivo, no el mínimo. -->
        <java.version>21</java.version>
        <maven.compiler.release>21</maven.compiler.release>
        <!-- Regla explícita del responsable: sin características preview. -->
        <maven.compiler.enablePreview>false</maven.compiler.enablePreview>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>

        <!-- ==================== Versiones propias ==================== -->
        <!-- Sólo lo que Spring Boot NO gestiona. -->
        <archunit.version>1.5.1</archunit.version>
        <!-- MapStruct no viene en el BOM de Spring Boot: se fija aquí para que la
             dependencia y el procesador de anotaciones usen siempre la misma versión.
             Versión 1.6.3: compatible con Java 21 y sin dependencia de Lombok, que
             está prohibido (conventions.md §2). -->
        <mapstruct.version>1.6.3</mapstruct.version>
        <springdoc.version>3.1.1</springdoc.version>

        <!-- Construcción reproducible: misma entrada, mismo JAR. -->
        <project.build.outputTimestamp>2026-10-11T00:00:00Z</project.build.outputTimestamp>
    </properties>

    <dependencies>

        <!-- ==================== web ==================== -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- Validación de formato en los DTOs. Las reglas de negocio viven en el dominio. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!-- ==================== persistencia ==================== -->
        <!-- JPA sólo se usa en infrastructure.adapter.out.persistence. Nunca en el dominio (ADR-0003). -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>

        <!-- El esquema es sólo de Flyway. ddl-auto=validate en todos los perfiles. -->
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-core</artifactId>
        </dependency>
        <!-- El soporte de PostgreSQL es un módulo aparte desde Flyway 10. -->
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-database-postgresql</artifactId>
        </dependency>
        <!--
          IMPORTANTE en Spring Boot 4: la autoconfiguración de Flyway se movió a un módulo
          propio, spring-boot-flyway. Con flyway-core + flyway-database-postgresql a secas
          el build compila, la aplicación arranca y NO se ejecuta ninguna migración: el
          esquema nunca se crea y ddl-auto=validate no se queja porque todavía no hay
          entidades que validar. Fallo silencioso. Por eso este módulo es obligatorio.
          Ver spring-conventions.md §4.3.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-flyway</artifactId>
        </dependency>
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- ==================== operación ==================== -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>

        <!-- ==================== mapeo ==================== -->
        <!-- MapStruct genera en tiempo de compilación las implementaciones de las
             interfaces Mapper, sin Lombok y sin código escrito a mano. El procesador
             está declarado en maven-compiler-plugin: ver la nota de annotationProcessorPaths.
             Sólo se usa en la capa infrastructure; el dominio no se mapea. -->
        <dependency>
            <groupId>org.mapstruct</groupId>
            <artifactId>mapstruct</artifactId>
            <version>${mapstruct.version}</version>
        </dependency>

        <!-- ==================== pruebas ==================== -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- Pruebas de la capa web: @WebMvcTest, MockMvc y los slices de test MVC.
             Spring Boot 4 los movió a un starter propio: la clase WebMvcTest ya no está en
             spring-boot-test-autoconfigure, sino en org.springframework.boot.webmvc.test.autoconfigure.
             Sin este starter, @WebMvcTest no compila. Verificado el 2026-10-11 en US-004. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc-test</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- Testcontainers: gestor de contenedores para las pruebas de integración. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-testcontainers</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- Testcontainers 2.0 renombró los módulos: todos llevan ahora el prefijo
             "testcontainers-" y las clases se movieron a paquetes por motor de base de datos.
             Coordenadas verificadas contra el repositorio el 2026-10-11:
               org.testcontainers:junit-jupiter         -> YA NO EXISTE en 2.0
               org.testcontainers:testcontainers-junit-jupiter -> existe (2.0.5)
               org.testcontainers.postgresql          -> org.testcontainers:testcontainers-postgresql
               org.testcontainers.containers.PostgreSQLContainer
                                                     -> org.testcontainers.postgresql.PostgreSQLContainer -->
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-postgresql</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- Reglas de dependencia entre capas, verificadas en cada build.
             Se usa el módulo core (no archunit-junit5) a propósito: las reglas se ejecutan
             desde tests JUnit normales, sin depender del motor de ArchUnit ni de su
             compatibilidad con la versión de JUnit que fije Spring Boot. -->
        <dependency>
            <groupId>com.tngtech.archunit</groupId>
            <artifactId>archunit</artifactId>
            <version>${archunit.version}</version>
            <scope>test</scope>
        </dependency>

        <!-- Documentación OpenAPI 3 + Swagger UI, generados del código.
             La versión es explícita porque el BOM de Spring Boot no gestiona springdoc.
             Verificado el 2026-10-11: springdoc 3.1.1 se construye sobre Spring Boot 4.1.0,
             compatible con el 4.1.1 del proyecto. El US-005 activará los endpoints por
             perfil; aquí sólo se añade la dependencia para cerrar el spike de US-001. -->
        <!-- TODO(US-002): verificar que springdoc 3.1.1 funciona con Spring Boot 4.1.1.
             Si falla, evaluar bajar a Spring Boot 4.1.0 o esperar springdoc 3.1.x.
             Documentar decisión en ADR-0011. -->
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
            <version>${springdoc.version}</version>
        </dependency>

        <!--
          spring-security-crypto, y NO spring-boot-starter-security.

          La diferencia entre ambos es exactamente lo que importa en US-020. Este módulo
          trae SÓLO las implementaciones (BCryptPasswordEncoder, DelegatingPasswordEncoder) y
          no registra nada: añadirlo no cambia el comportamiento de ninguna ruta, sólo hace
          que exista el cifrado que pide RF-ID-03. El starter, en cambio, autoconfigura una
          cadena de filtros que bloquearía todos los endpoints —incluido el catálogo público
          y el de actuator— sin que exista todavía una configuración de seguridad hecha a
          propósito. Esa cadena llega con US-021 y US-022, no antes.

          Sin versión: la gestiona el BOM de Spring Boot.
        -->
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-crypto</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>

        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-api</artifactId>
            <version>0.12.3</version>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-impl</artifactId>
            <version>0.12.3</version>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-jackson</artifactId>
            <version>0.12.3</version>
            <scope>runtime</scope>
        </dependency>

        <!--
          Dependencias que se añaden más adelante, y por qué no están aquí:

            - spring-boot-starter-security + oauth2-resource-server → US-021 y US-022.
              Añadirlas ahora activaría la autoconfiguración de seguridad por defecto
              y bloquearía los endpoints, incluidos los de actuator, sin que todavía
              exista configuración de seguridad que lo resuelva intencionadamente.
              El cifrado, que sí hace falta ya, entra como spring-security-crypto: ese
              módulo no autoconfigura nada.

            - software.amazon.awssdk:* → US-050 y US-060 (Sprints 6 y 7).
              Además de llegar tarde, el requisito RNF-05 pide que el perfil por
              defecto arranque sin ningún servicio de AWS.

            - Lombok → nunca. Ver conventions.md §2.
        -->

    </dependencies>

    <build>
        <finalName>pizzeria-backend</finalName>

        <plugins>

            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>

            <!--
              MapStruct no es sólo una dependencia: sin su procesador de anotaciones
              declarado aquí, el build compila sin error pero NO genera ninguna
              implementación de las interfaces Mapper. El fallo aparece después, al
              arrancar la aplicación, como un NoClassDefFoundError o un bean ausente.

              Con annotationProcessorPaths el procesador queda explícito y aislado: sólo
              se ejecutan los procesadores que aquí se indican, sin que Maven descubra
              por su cuenta los que encuentre en el classpath. Es además la forma de
              impedir que Lombok se cuele de nuevo como procesador, que está prohibido.

              Sin <version>: el BOM de spring-boot-starter-parent la gestiona.
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <annotationProcessorPaths>
                        <path>
                            <groupId>org.mapstruct</groupId>
                            <artifactId>mapstruct-processor</artifactId>
                            <version>${mapstruct.version}</version>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
            </plugin>

            <!--
              Enforcer: convierte el ADR-0010 en una regla que se verifica sola.
              Con JDK 17 el build falla aquí, con un mensaje claro, en lugar de fallar
              más tarde con un error de bytecode incomprensible.
              Rango [21,) y no una ventana cerrada: Spring Boot admite 17..26.
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
                <version>3.6.3</version>
                <executions>
                    <execution>
                        <id>verificar-entorno</id>
                        <goals>
                            <goal>enforce</goal>
                        </goals>
                        <configuration>
                            <rules>
                                <requireJavaVersion>
                                    <version>[21,)</version>
                                    <message>
                                        El proyecto exige Java 21 LTS (ADR-0010).
                                        JAVA_HOME detectado: ${java.home}.
                                        Instala Eclipse Temurin 21 y define JAVA_HOME.
                                    </message>
                                </requireJavaVersion>
                                <requireMavenVersion>
                                    <version>[3.9.9,)</version>
                                    <message>
                                        El proyecto está validado con Maven 3.10.0.
                                        Usa el Maven Wrapper: ./mvnw
                                    </message>
                                </requireMavenVersion>
                                <banDuplicatePomDependencyVersions/>
                            </rules>
                            <fail>true</fail>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <!--
              Pruebas de integración (*IT). Se ejecutan en la fase verify, después de
              empaquetar, y no en la fase test: tardan y necesitan Docker.
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-failsafe-plugin</artifactId>
                <executions>
                    <execution>
                        <goals>
                            <goal>integration-test</goal>
                            <goal>verify</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>

            <!--
              Cobertura medida por paquete, para poder distinguir "muchas líneas getters"
              de "reglas de negocio probadas". El informe se genera en verify.
              Los umbrales por capa se fijan en el Sprint 5 (US-044).
            -->
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <version>0.8.15</version>
                <executions>
                    <execution>
                        <id>preparar-agente</id>
                        <goals>
                            <goal>prepare-agent</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>informe</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>report</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>

        </plugins>
    </build>

</project>