// Boceto del modelo de datos — MVP de pizzería
//
// Origen: Spring Boot + arquitectura hexagonal, 8 tablas.
//
// NO ES LA FUENTE DE VERDAD. Lo es docs/requirements/requirements-v1.0.md §7 y el SQL de
// backend/src/main/resources/db/migration/. Este archivo existe para poder generar un
// diagrama y para dejar por escrito de dónde salió cada decisión de forma.
//
// VER SIEMPRE LAS DIFERENCIAS DEBAJO antes de usar este boceto: hay tres puntos en los
// que este modelo se aparta de decisiones ya aprobadas. Si se regenera el SQL desde aquí
// sin revisar, se rompen.

Project pizzeria_mvp {
  database_type: 'PostgreSQL'
  Note: 'MVP de pizzeria - Spring Boot + Arquitectura Hexagonal'
}

// Los enumerados se modelan aquí como Enum de DBML por legibilidad del diagrama, pero el
// SQL los crea como CHECK con literales y NO como tipos ENUM de PostgreSQL.
// Motivo (spring-conventions.md §4.4): cambiar un valor de un ENUM exige ALTER TYPE y
// bloquea la tabla; con un CHECK no hay nada que alterar.
Enum user_role { CUSTOMER  ADMIN }
Enum pizza_size { SMALL  MEDIUM  LARGE }
Enum order_status { PENDING  CONFIRMED  DELIVERED  CANCELLED }
Enum payment_method { CASH }
Enum payment_status { UNPAID  PAID }
Enum fulfillment_type { PICKUP }

// ---------------------------------------------------------------------------------
// CLIENTES Y AUTENTICACION
// ---------------------------------------------------------------------------------
Table customers {
  id uuid [pk]
  full_name varchar(120) [not null]
  email varchar(254) [not null]
  password_hash varchar(255) [not null]
  phone varchar(30)
  active boolean [not null, default: true]
  role user_role [not null]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  Note: 'Clientes registrados. El email es unico SIN DISTINGUIR MAYUSCULAS mediante un indice funcional UNIQUE(lower(email)), no un UNIQUE simple ni CITEXT'
}

Table customer_roles {
  customer_id uuid [not null]
  role user_role [not null]

  indexes { (customer_id, role) [pk] }

  Note: 'Roles asignados a cada usuario. Nunca se aceptan desde el registro publico'
}

// ---------------------------------------------------------------------------------
// CATALOGO
// ---------------------------------------------------------------------------------
Table pizzas {
  id uuid [pk]
  name varchar(80) [not null]
  description varchar(500)
  image_key varchar(500)
  active boolean [not null, default: true]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  Note: 'Producto general, independiente de su tamano. image_key es la CLAVE del objeto en el almacenamiento, no una URL: el servidor genera la URL prefirmada (US-052)'
}

Table pizza_variants {
  id uuid [pk]
  pizza_id uuid [not null]
  size pizza_size [not null]
  price numeric(12,0) [not null]
  available boolean [not null, default: true]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes { (pizza_id, size) [unique]  pizza_id }

  Note: 'Cada presentacion tiene su propio precio y disponibilidad'
}

// ---------------------------------------------------------------------------------
// PEDIDOS
// ---------------------------------------------------------------------------------
Table orders {
  id uuid [pk]
  order_number varchar(20) [not null, unique]
  customer_id uuid [not null]
  status order_status [not null, default: 'PENDING']
  payment_method payment_method [not null, default: 'CASH']
  payment_status payment_status [not null, default: 'UNPAID']
  fulfillment_type fulfillment_type [not null, default: 'PICKUP']
  total_amount numeric(12,0) [not null]
  currency char(3) [not null, default: 'COP']
  placed_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  confirmed_at timestamptz
  cancelled_at timestamptz
  delivered_at timestamptz
  version bigint [not null, default: 0]

  indexes { customer_id  (customer_id, placed_at)  (status, placed_at) }

  Note: 'Cabecera del pedido. payment_status vive aqui y no en una tabla payments aparte: el modelo aprobado fija 8 tablas. Ver decisions-pending.md D15'
}

Table order_items {
  id uuid [pk]
  order_id uuid [not null]
  variant_id uuid [not null]
  pizza_name varchar(80) [not null]
  size pizza_size [not null]
  unit_price numeric(12,0) [not null]
  quantity integer [not null]
  line_total numeric(12,0) [not null]
  created_at timestamptz [not null, default: `now()`]

  indexes { order_id  variant_id }

  Note: 'FOTO HISTORICA: guarda nombre, tamano y precio del catalogo en el momento del pedido. Cambiar el catalogo no altera pedidos ya creados (RN-FH-02)'
}

// ---------------------------------------------------------------------------------
// PAGO EN EFECTIVO
// ---------------------------------------------------------------------------------
Table cash_payments {
  id uuid [pk]
  order_id uuid [not null, unique]
  amount numeric(12,0) [not null]
  received_by uuid [not null]
  paid_at timestamptz [not null, default: `now()`]

  Note: 'Registro del cobro efectivo. UNIQUE(order_id) es lo que IMPIDE EL DOBLE COBRO (RN-PG-07)'
}

// ---------------------------------------------------------------------------------
// AUDITORIA
// ---------------------------------------------------------------------------------
Table order_status_history {
  id uuid [pk]
  order_id uuid [not null]
  from_status order_status
  to_status order_status [not null]
  changed_by uuid [not null]
  reason varchar(300)
  changed_at timestamptz [not null, default: `now()`]

  indexes { (order_id, changed_at) }

  Note: 'Trazabilidad de las transiciones. Inmutable: no tiene endpoint de escritura'
}

// ---------------------------------------------------------------------------------
// RELACIONES
// ---------------------------------------------------------------------------------
Ref: customer_roles.customer_id > customers.id
Ref: pizza_variants.pizza_id > pizzas.id
Ref: orders.customer_id > customers.id
Ref: order_items.order_id > orders.id
Ref: order_items.variant_id > pizza_variants.id
Ref: cash_payments.order_id - orders.id
Ref: cash_payments.received_by > customers.id
Ref: order_status_history.order_id > orders.id
Ref: order_status_history.changed_by > customers.id

// =================================================================================
// DIFERENCIAS CON EL SQL REAL (backend/src/main/resources/db/migration/)
//
// Este DBML es un boceto recuperado de un diseño previo. Hay cuatro puntos en los que NO
// coincide con el SQL real, tres porque contradicen decisiones aprobadas y uno a favor:
//
// 1. ENUM vs CHECK                                                        [RECHAZADO]
//    Here: Enum de DBML, que dbdiagram genera como tipo ENUM de PostgreSQL.
//    SQL:  CHECK con literales.
//    Por que: spring-conventions.md §4.4 lo prohibe expresamente. Alterar un ENUM exige
//    ALTER TYPE y bloquea la tabla; un CHECK no tiene nada que alterar.
//
// 2. gen_random_uuid() vs UUID de la aplicación                            [RECHAZADO]
//    Here: `id uuid [pk, default: gen_random_uuid()]`.
//    SQL:  `id UUID PRIMARY KEY` sin DEFAULT.
//    Por que: conventions.md §9. El agregado necesita su identificador ANTES de
//    persistirse; si lo genera la base, hay que recuperarlo despues de insertar.
//
// 3. numeric(12,2) vs numeric(12,0)                                        [RECHAZADO]
//    Here: numeric(12,2), importes con centavos.
//    SQL:  numeric(12,0), importes enteros.
//    Por que: RN-IM-05 y decision D1. El peso colombiano no tiene subdivisión decimal.
//    Con NUMERIC(12,0) el CHECK line_total = unit_price * quantity es una igualdad EXACTA
//    y el motor la usa como verificacion de integridad real. Con dos decimales habria que
//    relajarla para tolerar fracciones, que es justo lo que no se quiere.
//
// 4. Timestamps por estado en orders                                      [ADOPTADO]
//    Here: confirmed_at, cancelled_at, delivered_at.
//    SQL:  tambien. Guardan el HECHO, no el updated_at generico, y permiten medir cuanto
//    tarda un pedido en confirmarse o entregarse. Admitido sin cambios.
//
// Lo que el SQL anade y este boceto no expresa (DBML no los modela):
//   · CHECK de negocio: price > 0, quantity entre 1 y 20, total_amount >= 0, coherencia
//     de las marcas de tiempo con el estado, y enumerados validos.
//   · Indices unicos parciales: pizzas activas sin nombre duplicado, pizza sin dos
//     variantes del mismo tamaño.
//   · ON DELETE RESTRICT explicito en todas las claves foraneas.
//   · Constraint trigger DEFERRABLE que verifica orders.total_amount = SUM(line_total).
//   · Coherencia entre confirmed_at / delivered_at / cancelled_at y el estado actual.
// =================================================================================