// ============================================================
// PIZZERIA - Database Schema
// DBML for dbdiagram.io
// ============================================================

// ---------- ENUMS ----------
Enum user_role {
  CLIENTE
  COOK
  ADMIN
}

Enum order_status {
  RECEIVED
  IN_PREPARATION
  READY
  ON_THE_WAY
  DELIVERED
  CANCELLED
}

Enum payment_method {
  CASH
  CARD_ON_DELIVERY
  BANK_TRANSFER
}

// ---------- TABLES ----------

Table users {
  id            bigint      [pk, default: `gen_random_bigint()`]
  email         varchar(150) [unique, not null]
  password_hash varchar(255) [not null]
  first_name    varchar(100) [not null]
  last_name     varchar(100) [not null]
  phone         varchar(20)
  role          user_role   [not null, default: 'CLIENTE']
  enabled       boolean     [not null, default: true]
  created_at    timestamp   [not null, default: `now()`]
  updated_at    timestamp   [not null, default: `now()`]

  indexes {
    email [unique]
    role
  }
  Note: 'Clientes, cocina y administradores. Un solo usuario con rol.'
}

Table addresses {
  id           bigint      [pk, default: `gen_random_bigint()`]
  user_id      bigint    [not null, ref: > users.id]
  alias        varchar(50)  [not null]
  street       varchar(200) [not null]
  city         varchar(100) [not null]
  neighborhood varchar(100)
  reference    text
  is_default   boolean   [not null, default: false]
  created_at   timestamp [not null, default: `now()`]
  updated_at   timestamp [not null, default: `now()`]

  indexes {
    user_id
  }
  Note: 'Un cliente puede tener varias direcciones. Una marcada como default.'
}

Table categories {
  id          bigint      [pk, default: `gen_random_bigint()`]
  name        varchar(100) [not null]
  description text
  active      boolean   [not null, default: true]
  created_at  timestamp [not null, default: `now()`]
  updated_at  timestamp [not null, default: `now()`]

  indexes {
    name [unique]
  }
}

Table products {
  id           bigint      [pk, default: `gen_random_bigint()`]
  category_id  bigint    [not null, ref: > categories.id]
  name         varchar(150) [not null]
  description  text
  price        decimal(10,2) [not null]
  image_url    varchar(500)
  available    boolean   [not null, default: true]
  created_at   timestamp [not null, default: `now()`]
  updated_at   timestamp [not null, default: `now()`]

  indexes {
    category_id
    name
    available
  }
  Note: 'productos del menú. image_url apunta a S3 (Floci en local).'
}

Table ingredients {
  id          bigint      [pk, default: `gen_random_bigint()`]
  name        varchar(100) [not null]
  available   boolean   [not null, default: true]
  created_at  timestamp [not null, default: `now()`]
  updated_at  timestamp [not null, default: `now()`]

  indexes {
    name [unique]
  }
}

Table product_ingredients {
  product_id     bigint [not null, ref: > products.id]
  ingredient_id  bigint [not null, ref: > ingredients.id]
  quantity       decimal(10,2)

  indexes {
    (product_id, ingredient_id) [pk]
  }
  Note: 'Relación N:M. Qué ingredientes lleva cada producto.'
}

Table orders {
  id              bigint      [pk, default: `gen_random_bigint()`]
  user_id         bigint    [not null, ref: > users.id]
  address_id      bigint    [not null, ref: > addresses.id]
  status          order_status  [not null, default: 'RECEIVED']
  payment_method  payment_method [not null]
  subtotal        decimal(10,2) [not null]
  delivery_fee    decimal(10,2) [not null, default: 0]
  total           decimal(10,2) [not null]
  notes           text
  created_at      timestamp [not null, default: `now()`]
  updated_at      timestamp [not null, default: `now()`]

  indexes {
    user_id
    status
    created_at
  }
  Note: 'Cabecera del pedido. El total se calcula en el dominio (no en DB).'
}

Table order_items {
  id              bigint      [pk, default: `gen_random_bigint()`]
  order_id        bigint    [not null, ref: > orders.id]
  product_id      bigint      [not null, ref: > products.id]
  quantity        int       [not null]
  unit_price      decimal(10,2) [not null]
  subtotal        decimal(10,2) [not null]
  notes           text

  indexes {
    order_id
    product_id
  }
  Note: 'unit_price se congela al momento de la compra (histórico).'
}

Table order_status_history {
  id             bigint      [pk, default: `gen_random_bigint()`]
  order_id       bigint    [not null, ref: > orders.id]
  previous_status order_status
  new_status     order_status [not null]
  changed_by     bigint    [ref: > users.id]
  created_at     timestamp [not null, default: `now()`]

  indexes {
    order_id
    created_at
  }
  Note: 'Auditoría del ciclo de vida del pedido.'
}
