# Plantilla de variables de entorno del entorno LOCAL.
#
#   Copia este archivo a .env, aquí al lado:  Copy-Item .env.example .env
#
# Vive junto a docker-compose.yml a propósito. Compose busca el archivo .env en el
# directorio del propio compose, no en la raíz del repositorio; si estuviera arriba, el
# comando `docker compose -f infra/local/docker-compose.yml up` fallaría pidiendo las
# variables y no por una razón evidente.
#
# .env está en .gitignore y NUNCA se versiona. Este archivo sí se versiona y por eso
# sus valores son de mentira: sirven para levantar la máquina en local, no para nada más.
#
# Ninguna de estas credenciales sirve fuera de tu máquina. En cualquier otro entorno
# llegan por variables del sistema o por un gestor de secretos.

# ---- Base de datos local -------------------------------------------------------
POSTGRES_DB=pizzeria
POSTGRES_USER=pizzeria_dev

# Contraseña de la base de datos local.
# Es un valor de mentira y sólo existe en esta máquina, pero se trata como si fuera
# real: nunca se reutiliza, nunca se copia a otro entorno.
POSTGRES_PASSWORD=cambia_esta_contrasena_local

# Puerto que publica la APLICACIÓN (HTTP). El de PostgreSQL no se publica.
APP_PORT=8080