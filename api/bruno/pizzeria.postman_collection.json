{
  "info": {
    "_postman_id": "a1b2c3d4-e5f6-7890-abcd-ef1234567890",
    "name": "Pizzeria API",
    "description": "Colección alineada con el estado actual del backend. Autenticación JWT (HS256). Base: http://localhost:8080",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080" },
    { "key": "token",   "value": "" },
    { "key": "productId", "value": "1" },
    { "key": "categoryId", "value": "1" },
    { "key": "orderId",  "value": "1" },
    { "key": "addressId", "value": "1" }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Registrar cliente",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"lucia@pizzeria.co\",\n  \"password\": \"password123\",\n  \"firstName\": \"Lucia\",\n  \"lastName\": \"Perez\",\n  \"phone\": \"+573001234567\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/v1/auth/register" },
            "description": "Crea un cliente con rol CUSTOMER. El rol nunca se acepta en el cuerpo (RF-ID-04). Responde 201 sin token."
          },
          "response": [
            {
              "name": "201 Creado",
              "status": "Created", "code": 201,
              "_postman_previewlanguage": "json",
              "header": [{ "key": "Content-Type", "value": "application/json" }],
              "body": "{\"id\":1,\"email\":\"lucia@pizzeria.co\",\"firstName\":\"Lucia\",\"lastName\":\"Perez\",\"phone\":\"+573001234567\",\"role\":\"CLIENTE\",\"createdAt\":\"2026-10-18T15:00:00Z\"}"
            },
            {
              "name": "409 Email ya registrado",
              "status": "Conflict", "code": 409,
              "_postman_previewlanguage": "json",
              "header": [{ "key": "Content-Type", "value": "application/problem+json" }],
              "body": "{\"code\":\"IDENTITY_EMAIL_ALREADY_REGISTERED\",\"status\":409,\"detail\":\"El email ya esta registrado\"}"
            },
            {
              "name": "400 Campo desconocido (role en el cuerpo)",
              "status": "Bad Request", "code": 400,
              "_postman_previewlanguage": "json",
              "header": [{ "key": "Content-Type", "value": "application/problem+json" }],
              "body": "{\"code\":\"MALFORMED_REQUEST\",\"status\":400,\"detail\":\"El cuerpo de la peticion no es valido\"}"
            }
          ]
        },
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();",
                  "if (res.token) {",
                  "  pm.collectionVariables.set('token', res.token);",
                  "  console.log('token guardado');",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"lucia@pizzeria.co\",\n  \"password\": \"password123\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/v1/auth/login" },
            "description": "Devuelve JWT. El script de test guarda el token en la variable de colección."
          },
          "response": [
            {
              "name": "200 OK",
              "status": "OK", "code": 200,
              "_postman_previewlanguage": "json",
              "header": [{ "key": "Content-Type", "value": "application/json" }],
              "body": "{\"token\":\"eyJ...\",\"userId\":1,\"email\":\"lucia@pizzeria.co\",\"role\":\"CLIENTE\"}"
            },
            {
              "name": "401 Credenciales incorrectas",
              "status": "Unauthorized", "code": 401,
              "_postman_previewlanguage": "json",
              "header": [{ "key": "Content-Type", "value": "application/problem+json" }],
              "body": "{\"code\":\"IDENTITY_INVALID_CREDENTIALS\",\"status\":401,\"detail\":\"Credenciales invalidas\"}"
            }
          ]
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": { "raw": "{{baseUrl}}/api/v1/auth/logout" }
          }
        }
      ]
    },
    {
      "name": "Clientes",
      "item": [
        {
          "name": "Mi perfil",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{baseUrl}}/api/v1/customers/me" },
            "description": "Devuelve el perfil del cliente autenticado. Nunca incluye la contraseña (RF-ID-07, RF-ID-08)."
          },
          "response": [
            {
              "name": "200 OK",
              "status": "OK", "code": 200,
              "_postman_previewlanguage": "json",
              "header": [{ "key": "Content-Type", "value": "application/json" }],
              "body": "{\"id\":1,\"email\":\"lucia@pizzeria.co\",\"firstName\":\"Lucia\",\"lastName\":\"Perez\",\"phone\":\"+573001234567\",\"role\":\"CLIENTE\",\"createdAt\":\"2026-10-18T15:00:00Z\"}"
            }
          ]
        }
      ]
    },
    {
      "name": "Categorias - Publico",
      "item": [
        {
          "name": "Listar categorias activas",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/categories",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "categories"]
            },
            "description": "Devuelve las categorías activas (Pizzas, Bebidas, etc.). Público, sin token."
          },
          "response": [
            {
              "name": "200 OK",
              "status": "OK", "code": 200,
              "_postman_previewlanguage": "json",
              "header": [{ "key": "Content-Type", "value": "application/json" }],
              "body": "[{\"id\":1,\"name\":\"Pizzas\",\"description\":\"Nuestras pizzas artesanales\"},{\"id\":2,\"name\":\"Bebidas\",\"description\":\"Gaseosas y jugos\"}]"
            }
          ]
        }
      ]
    },
    {
      "name": "Productos - Publico",
      "item": [
        {
          "name": "Listar productos",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/products?onlyAvailable=true&page=0&size=20",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "products"],
              "query": [
                { "key": "categoryId",    "value": "",     "disabled": true, "description": "Filtro opcional por categoría" },
                { "key": "onlyAvailable", "value": "true", "description": "true = solo disponibles (default)" },
                { "key": "page",          "value": "0" },
                { "key": "size",          "value": "20" }
              ]
            },
            "description": "Catálogo paginado. Filtrar por categoría con ?categoryId=1. Público, sin token."
          },
          "response": [
            {
              "name": "200 OK",
              "status": "OK", "code": 200,
              "_postman_previewlanguage": "json",
              "header": [{ "key": "Content-Type", "value": "application/json" }],
              "body": "{\"content\":[{\"id\":1,\"categoryId\":1,\"name\":\"Margarita\",\"description\":\"Tomate y mozzarella\",\"price\":12000,\"imageUrl\":null,\"available\":true}],\"page\":0,\"size\":20,\"totalElements\":1,\"totalPages\":1}"
            }
          ]
        },
        {
          "name": "Detalle de producto",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/products/{{productId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "products", "{{productId}}"]
            }
          },
          "response": [
            {
              "name": "200 OK",
              "status": "OK", "code": 200,
              "_postman_previewlanguage": "json",
              "header": [{ "key": "Content-Type", "value": "application/json" }],
              "body": "{\"id\":1,\"categoryId\":1,\"name\":\"Margarita\",\"description\":\"Tomate y mozzarella\",\"price\":12000,\"imageUrl\":null,\"available\":true}"
            },
            {
              "name": "404 No encontrado",
              "status": "Not Found", "code": 404,
              "_postman_previewlanguage": "json",
              "header": [{ "key": "Content-Type", "value": "application/problem+json" }],
              "body": "{\"code\":\"CATALOG_PIZZA_NOT_FOUND\",\"status\":404,\"detail\":\"Producto no encontrado: 999\"}"
            }
          ]
        },
        {
          "name": "Listar productos por categoria",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/products?categoryId={{categoryId}}&onlyAvailable=true&page=0&size=20",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "products"],
              "query": [
                { "key": "categoryId",    "value": "{{categoryId}}" },
                { "key": "onlyAvailable", "value": "true" },
                { "key": "page",          "value": "0" },
                { "key": "size",          "value": "20" }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Direcciones",
      "item": [
        {
          "name": "Crear direccion",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type",  "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"alias\": \"casa\",\n  \"street\": \"calle 1 # 2-3\",\n  \"city\": \"Bogota\",\n  \"neighborhood\": \"Centro\",\n  \"reference\": \"Porton verde\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/v1/addresses" },
            "description": "El propietario sale del token. Un userId en el cuerpo devuelve 400 MALFORMED_REQUEST."
          },
          "response": [
            {
              "name": "201 Creada",
              "status": "Created", "code": 201,
              "_postman_previewlanguage": "json",
              "header": [{ "key": "Content-Type", "value": "application/json" }],
              "body": "{\"id\":1,\"alias\":\"casa\",\"street\":\"calle 1 # 2-3\",\"city\":\"Bogota\",\"neighborhood\":\"Centro\",\"reference\":\"Porton verde\",\"createdAt\":\"2026-10-30T03:46:50Z\"}"
            }
          ]
        },
        {
          "name": "Listar mis direcciones",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{baseUrl}}/api/v1/addresses" },
            "description": "Solo las direcciones del cliente del token, de más reciente a más antigua."
          }
        }
      ]
    },
    {
      "name": "Pedidos",
      "item": [
        {
          "name": "Crear pedido",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();",
                  "if (res.id) pm.collectionVariables.set('orderId', res.id);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type",  "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"addressId\": {{addressId}},\n  \"paymentMethod\": \"CASH\",\n  \"notes\": \"Sin cebolla\",\n  \"items\": [\n    { \"productId\": {{productId}}, \"quantity\": 2, \"notes\": \"\" }\n  ]\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/v1/orders" }
          },
          "response": [
            {
              "name": "404 Direccion inexistente o ajena",
              "status": "Not Found", "code": 404,
              "_postman_previewlanguage": "json",
              "header": [{ "key": "Content-Type", "value": "application/problem+json" }],
              "body": "{\"code\":\"IDENTITY_ADDRESS_NOT_FOUND\",\"status\":404,\"detail\":\"Direccion no encontrada: 999\"}"
            }
          ]
        },
        {
          "name": "Listar mis pedidos",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{baseUrl}}/api/v1/orders" }
          }
        },
        {
          "name": "Detalle de pedido",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": {
              "raw": "{{baseUrl}}/api/v1/orders/{{orderId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "orders", "{{orderId}}"]
            }
          }
        },
        {
          "name": "Cancelar pedido",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type",  "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/orders/{{orderId}}/cancel",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "orders", "{{orderId}}", "cancel"]
            },
            "description": "Solo pedidos propios en estado PENDING."
          }
        }
      ]
    },
    {
      "name": "Pedidos - Empleado",
      "item": [
        {
          "name": "Listar todos los pedidos",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": {
              "raw": "{{baseUrl}}/api/v1/employee/orders",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "employee", "orders"],
              "query": [
                { "key": "status", "value": "PENDING", "disabled": true, "description": "Filtro opcional por estado" }
              ]
            }
          }
        },
        {
          "name": "Confirmar pedido",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": {
              "raw": "{{baseUrl}}/api/v1/employee/orders/{{orderId}}/confirm",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "employee", "orders", "{{orderId}}", "confirm"]
            }
          }
        },
        {
          "name": "Cancelar pedido (empleado)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type",  "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"reason\": \"Cancelado por empleado\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/employee/orders/{{orderId}}/cancel",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "employee", "orders", "{{orderId}}", "cancel"]
            }
          }
        },
        {
          "name": "Registrar recogida y cobro",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": {
              "raw": "{{baseUrl}}/api/v1/employee/orders/{{orderId}}/complete-pickup",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "employee", "orders", "{{orderId}}", "complete-pickup"]
            }
          }
        }
      ]
    }
  ]
}
